<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#07152f">
  <meta name="description" content="Mini App DevelopmentR provides professional Android app development, UI/UX design, Google Play Store publishing, app maintenance and management services in India.">
  <meta name="keywords" content="Android App Development, Mobile App Development India, Google Play Store Publishing, Android App Design, UI UX Design, App Management, Mini App DevelopmentR, SkyPoints Rush">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Mini App DevelopmentR | Android App Development & Publishing">
  <meta property="og:description" content="We design, develop, publish and manage innovative Android applications.">
  <meta property="og:locale" content="en_IN">
  <title>Mini App DevelopmentR | Android App Development &amp; Publishing</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%230b65e5'/%3E%3Cpath d='M22 68V32h12l16 19 16-19h12v36H66V51L50 69 34 51v17z' fill='white'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --navy:#07152f; --navy2:#0b2045; --blue:#1769e8; --blue2:#3e8cff;
      --cyan:#68c8ff; --ink:#12213b; --muted:#63718a; --pale:#f3f7ff;
      --line:#e5ecf7; --white:#fff; --shadow:0 18px 55px rgba(13,45,94,.10);
      --radius:22px;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;scroll-padding-top:90px}
    body{font-family:"DM Sans",sans-serif;color:var(--ink);background:#fff;line-height:1.65;overflow-x:hidden}
    h1,h2,h3,h4{font-family:Manrope,sans-serif;line-height:1.18;letter-spacing:-.035em}
    a{text-decoration:none;color:inherit}
    button,input,textarea{font:inherit}
    .container{width:min(1160px,calc(100% - 40px));margin:auto}
    .section{padding:100px 0}
    .section-head{max-width:680px;margin:0 auto 52px;text-align:center}
    .eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--blue);font-weight:700;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;margin-bottom:16px}
    .eyebrow:before{content:"";width:25px;height:2px;background:currentColor;border-radius:3px}
    .section-head h2{font-size:clamp(2rem,4vw,3rem);color:var(--navy);margin-bottom:16px}
    .section-head p{color:var(--muted);font-size:1.04rem}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:14px 22px;border-radius:12px;font-weight:700;border:1px solid transparent;transition:.25s ease;cursor:pointer}
    .btn-primary{background:linear-gradient(135deg,var(--blue),#398dff);color:#fff;box-shadow:0 10px 25px rgba(23,105,232,.22)}
    .btn-primary:hover{transform:translateY(-3px);box-shadow:0 15px 30px rgba(23,105,232,.3)}
    .btn-outline{border-color:rgba(255,255,255,.28);color:#fff;background:rgba(255,255,255,.06)}
    .btn-outline:hover{background:#fff;color:var(--navy)}
    .btn-light{background:#fff;color:var(--navy);border-color:var(--line)}
    .btn-light:hover{border-color:var(--blue);color:var(--blue);transform:translateY(-2px)}
    /* Header */
    .site-header{height:82px;position:sticky;top:0;z-index:1000;background:rgba(255,255,255,.92);backdrop-filter:blur(16px);border-bottom:1px solid rgba(225,234,247,.8)}
    .nav-wrap{height:100%;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .brand{display:flex;align-items:center;gap:11px;font-family:Manrope,sans-serif;font-weight:800;color:var(--navy);font-size:1.03rem;white-space:nowrap}
    .brand-mark{height:42px;width:42px;border-radius:13px;display:grid;place-items:center;color:#fff;background:linear-gradient(145deg,#0d56ce,#48a5ff);font-size:1.1rem;box-shadow:0 8px 18px #1769e833}
    .brand small{display:block;color:#73819a;font:600 .62rem "DM Sans",sans-serif;letter-spacing:.12em;text-transform:uppercase;margin-top:-3px}
    .nav-links{display:flex;align-items:center;gap:28px}
    .nav-links a{font-size:.9rem;font-weight:600;color:#4c5b73;transition:.2s}
    .nav-links a:hover,.nav-links a.active{color:var(--blue)}
    .nav-cta{padding:11px 17px;font-size:.88rem}
    .menu-toggle{display:none;background:none;border:0;color:var(--navy);font-size:1.4rem;cursor:pointer}
    /* Hero */
    .hero{position:relative;isolation:isolate;overflow:hidden;background:radial-gradient(circle at 76% 38%,#1d4e93 0,#102b57 28%,#07152f 66%);color:#fff;padding:92px 0 104px}
    .hero:before,.hero:after{content:"";position:absolute;border:1px solid rgba(116,184,255,.15);border-radius:50%;z-index:-1}
    .hero:before{width:620px;height:620px;right:-120px;top:-260px;box-shadow:0 0 0 55px rgba(76,151,255,.035),0 0 0 110px rgba(76,151,255,.025)}
    .hero:after{width:420px;height:420px;left:-260px;bottom:-300px}
    .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:55px}
    .hero-copy .eyebrow{color:#8dc9ff}
    .hero h1{font-size:clamp(2.7rem,5.5vw,4.65rem);max-width:690px;margin-bottom:22px}
    .hero h1 span{background:linear-gradient(90deg,#fff,#81caff);-webkit-background-clip:text;background-clip:text;color:transparent}
    .hero-copy>p{font-size:1.08rem;color:#c4d3e9;max-width:590px;margin-bottom:30px}
    .hero-actions{display:flex;flex-wrap:wrap;gap:13px}
    .hero-proof{display:flex;align-items:center;gap:14px;margin-top:34px;color:#b7c9e2;font-size:.87rem}
    .proof-icon{width:36px;height:36px;display:grid;place-items:center;border-radius:50%;background:#ffffff16;color:#8dccff}
    .hero-visual{position:relative;min-height:480px;display:grid;place-items:center}
    .glow{position:absolute;width:360px;height:360px;border-radius:50%;background:#2887ff55;filter:blur(70px)}
    .phone{position:relative;width:245px;height:455px;padding:10px;border-radius:37px;background:linear-gradient(145deg,#e8f1ff,#647b9e 45%,#0b1830);box-shadow:0 35px 70px #0008;transform:rotate(-7deg);z-index:2}
    .phone-inner{height:100%;border-radius:29px;overflow:hidden;background:linear-gradient(160deg,#e8f6ff,#a7d4ff 50%,#367cda);position:relative;color:#102a54}
    .phone-notch{position:absolute;z-index:3;top:8px;left:50%;transform:translateX(-50%);width:80px;height:17px;border-radius:20px;background:#09172c}
    .game-top{padding:43px 17px 10px;display:flex;justify-content:space-between;font-size:.65rem;font-weight:800}
    .game-sky{height:245px;position:relative;overflow:hidden;background:linear-gradient(#67c5ff,#d9f4ff 75%);margin:5px 10px;border-radius:20px}
    .cloud{position:absolute;width:70px;height:22px;border-radius:30px;background:#fff;opacity:.8}
    .cloud:before,.cloud:after{content:"";position:absolute;background:inherit;border-radius:50%}
    .cloud:before{width:30px;height:30px;left:12px;top:-12px}.cloud:after{width:25px;height:25px;right:10px;top:-8px}
    .cloud.one{top:43px;left:8px}.cloud.two{top:105px;right:-15px;transform:scale(.8)}
    .plane{position:absolute;top:105px;left:50%;transform:translateX(-50%) rotate(-8deg);font-size:3.5rem;color:#1556b8;filter:drop-shadow(0 8px 5px #1455a655)}
    .game-score{position:absolute;top:12px;left:12px;background:#fff9;border-radius:10px;padding:6px 10px;font-size:.58rem;font-weight:800}
    .game-bottom{text-align:center;padding:10px}
    .game-bottom strong{display:block;font:800 1.05rem Manrope;color:#0a2c61}
    .game-bottom span{font-size:.62rem;color:#325b8d}
    .game-cta{margin:9px auto 0;background:#1264d8;color:white;width:80%;padding:8px;border-radius:20px;font-size:.65rem;font-weight:800}
    .float-card{position:absolute;z-index:4;padding:13px 16px;border:1px solid #ffffff35;border-radius:15px;background:#ffffffed;color:var(--navy);box-shadow:0 16px 35px #00122d55;display:flex;align-items:center;gap:11px;font-size:.8rem;font-weight:700}
    .float-card i{width:35px;height:35px;display:grid;place-items:center;background:#e8f2ff;color:var(--blue);border-radius:10px;font-size:1rem}
    .float-one{top:72px;right:-5px}.float-two{bottom:67px;left:-10px}
    /* About */
    .about-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:65px;align-items:center}
    .about-art{min-height:390px;border-radius:28px;background:linear-gradient(145deg,#eaf3ff,#d7e9ff);position:relative;overflow:hidden;display:grid;place-items:center}
    .about-art:before{content:"";position:absolute;width:270px;height:270px;border-radius:50%;border:1px solid #8ebcff80;box-shadow:0 0 0 35px #fff4,0 0 0 70px #fff3}
    .about-symbol{position:relative;width:150px;height:150px;border-radius:38px;background:linear-gradient(145deg,#1263dc,#53a5ff);display:grid;place-items:center;color:#fff;font-size:4rem;box-shadow:0 25px 45px #1769e844}
    .art-tag{position:absolute;background:#fff;padding:12px 17px;border-radius:14px;box-shadow:var(--shadow);font-weight:700;font-size:.82rem;color:#25456e}
    .art-tag.a{top:50px;left:25px}.art-tag.b{bottom:48px;right:22px}
    .about-copy .eyebrow{margin-bottom:13px}.about-copy h2{font-size:clamp(2rem,4vw,2.8rem);color:var(--navy);margin-bottom:18px}
    .about-copy p{color:var(--muted);margin-bottom:15px}
    .feature-mini{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:28px}
    .mini-item{padding:17px 13px;border:1px solid var(--line);border-radius:15px;background:#fff}
    .mini-item i{color:var(--blue);font-size:1.2rem;margin-bottom:10px}.mini-item strong{display:block;font-size:.82rem;line-height:1.35}
    /* Services */
    .services{background:var(--pale)}
    .cards-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    .service-card{background:#fff;border:1px solid #e9eff8;border-radius:20px;padding:28px 25px;transition:.28s;box-shadow:0 8px 24px #153e7510}
    .service-card:hover{transform:translateY(-7px);box-shadow:var(--shadow);border-color:#c9ddff}
    .service-icon{width:54px;height:54px;border-radius:16px;background:linear-gradient(145deg,#eaf3ff,#dceaff);display:grid;place-items:center;color:var(--blue);font-size:1.35rem;margin-bottom:22px}
    .service-card h3{font-size:1.12rem;color:var(--navy);margin-bottom:10px}
    .service-card p{font-size:.91rem;color:var(--muted)}
    /* Live app */
    .live-section{background:linear-gradient(130deg,#07152f,#0d2b5c);color:#fff;overflow:hidden;position:relative}
    .live-section:after{content:"";position:absolute;width:520px;height:520px;right:-230px;top:-260px;border-radius:50%;border:1px solid #72baff2b;box-shadow:0 0 0 65px #72baff09,0 0 0 130px #72baff08}
    .live-section .section-head h2{color:#fff}.live-section .section-head p{color:#b8c9e2}.live-section .eyebrow{color:#83c4ff}
    .live-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;position:relative;z-index:1}
    .app-preview{min-height:390px;display:grid;place-items:center;position:relative}
    .app-tile{width:210px;height:210px;border-radius:48px;background:linear-gradient(145deg,#7f5bff,#1769e8 60%,#51c6ff);display:grid;place-items:center;box-shadow:0 25px 65px #0006;position:relative;transform:rotate(-8deg)}
    .app-tile:before{content:"";position:absolute;inset:13px;border:1px solid #ffffff66;border-radius:38px}
    .app-tile i{font-size:5.3rem;color:#fff;filter:drop-shadow(0 8px 5px #001c4d55)}
    .app-orbit{position:absolute;width:310px;height:310px;border:1px dashed #8bc8ff70;border-radius:50%;animation:spin 28s linear infinite}
    .app-orbit:before{content:"";position:absolute;width:15px;height:15px;background:#75d5ff;border-radius:50%;top:25px;left:45px;box-shadow:0 0 20px #75d5ff}
    @keyframes spin{to{transform:rotate(360deg)}}
    .live-copy .live-badge{display:inline-flex;align-items:center;gap:8px;background:#123f70;color:#9dd5ff;border:1px solid #3479b7;padding:7px 12px;border-radius:30px;font-size:.76rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:18px}
    .live-badge:before{content:"";width:7px;height:7px;border-radius:50%;background:#3ee2a0;box-shadow:0 0 0 4px #3ee2a022}
    .live-copy h2{font-size:clamp(2.2rem,4vw,3.3rem);margin-bottom:17px}.live-copy p{color:#bdcde3;margin-bottom:22px}
    .app-points{display:flex;flex-wrap:wrap;gap:12px 20px;margin:0 0 27px;color:#d7e5f8;font-size:.88rem}
    .app-points span{display:flex;align-items:center;gap:8px}.app-points i{color:#67c9ff}
    .play-badge{display:inline-flex;align-items:center;gap:11px;background:#fff;color:#14213a;border-radius:12px;padding:10px 16px;font-weight:700;margin-top:15px;transition:.2s}
    .play-badge:hover{transform:translateY(-3px)}.play-badge i{font-size:1.7rem;color:#159c67}
    .play-badge small{display:block;font-size:.58rem;font-weight:600;line-height:1.1}.play-badge strong{font-size:.92rem}
    /* Why */
    .why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .why-item{display:flex;gap:15px;padding:22px;border-radius:17px;border:1px solid var(--line);background:#fff}
    .why-item i{flex:0 0 42px;height:42px;border-radius:12px;background:#eaf3ff;color:var(--blue);display:grid;place-items:center;font-size:1.05rem}
    .why-item h3{font-size:1rem;margin-bottom:6px;color:var(--navy)}.why-item p{font-size:.85rem;color:var(--muted)}
    /* Process */
    .process{background:var(--pale)}
    .process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;position:relative}
    .process-grid:before{content:"";position:absolute;left:12%;right:12%;top:35px;border-top:2px dashed #b8d2f8}
    .process-step{position:relative;text-align:center;padding:0 10px}
    .step-icon{width:72px;height:72px;border-radius:22px;background:#fff;border:1px solid #dce9fb;box-shadow:0 8px 24px #174a8b12;display:grid;place-items:center;margin:0 auto 22px;color:var(--blue);font-size:1.45rem;position:relative;z-index:1}
    .step-num{position:absolute;top:-8px;right:calc(50% - 43px);width:23px;height:23px;border-radius:50%;background:var(--blue);color:#fff;font-size:.68rem;font-weight:800;display:grid;place-items:center;z-index:2}
    .process-step h3{font-size:1.05rem;margin-bottom:8px;color:var(--navy)}.process-step p{font-size:.87rem;color:var(--muted)}
    /* Contact */
    .contact{background:#fff}
    .contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:50px;align-items:start}
    .contact-info{background:linear-gradient(145deg,#081832,#12396d);color:#fff;padding:36px;border-radius:24px;position:relative;overflow:hidden}
    .contact-info:after{content:"";position:absolute;width:220px;height:220px;border:1px solid #ffffff18;border-radius:50%;right:-100px;bottom:-100px;box-shadow:0 0 0 35px #ffffff08}
    .contact-info h3{font-size:1.7rem;margin-bottom:12px}.contact-info>p{color:#b9cbe4;margin-bottom:28px;font-size:.94rem}
    .contact-line{display:flex;gap:14px;margin:21px 0;position:relative;z-index:1}
    .contact-line i{width:40px;height:40px;flex:0 0 40px;border-radius:12px;background:#ffffff15;color:#8dcaff;display:grid;place-items:center}
    .contact-line small{display:block;color:#9fb5d3;font-size:.73rem;margin-bottom:3px}.contact-line a,.contact-line span{font-size:.88rem;color:#fff;overflow-wrap:anywhere}
    .social-row{display:flex;gap:10px;margin-top:27px}.social-row a{width:38px;height:38px;border-radius:11px;background:#ffffff16;display:grid;place-items:center;color:#fff;transition:.2s}.social-row a:hover{background:var(--blue);transform:translateY(-3px)}
    .contact-form{padding:8px 0}
    .contact-form h3{font-size:1.65rem;color:var(--navy);margin-bottom:8px}.contact-form>p{color:var(--muted);margin-bottom:25px;font-size:.93rem}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}
    .field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}
    .field label{font-size:.82rem;font-weight:700;color:#34435c}
    .field input,.field textarea{width:100%;border:1px solid #dfe7f2;border-radius:11px;padding:13px 14px;outline:none;background:#fbfdff;color:var(--ink);transition:.2s}
    .field input:focus,.field textarea:focus{border-color:#6aa6f7;box-shadow:0 0 0 3px #1769e814;background:#fff}
    .field textarea{min-height:130px;resize:vertical}
    .form-note{font-size:.76rem;color:#7b879a;margin-top:12px}
    /* Footer */
    footer{background:#061126;color:#fff;padding:60px 0 22px}
    .footer-grid{display:grid;grid-template-columns:1.5fr .8fr .8fr;gap:55px;padding-bottom:42px}
    .footer-brand .brand{color:#fff;margin-bottom:18px}.footer-brand p{color:#9eacc2;max-width:370px;font-size:.9rem}
    .footer-tag{color:#8cbfff;font-size:.78rem;font-weight:700;letter-spacing:.05em;margin-top:15px}
    .footer-col h4{font-size:1rem;margin-bottom:18px}.footer-col a{display:block;color:#aab7ca;font-size:.88rem;margin:10px 0;transition:.2s}.footer-col a:hover{color:#fff;transform:translateX(3px)}
    .footer-bottom{border-top:1px solid #ffffff16;padding-top:20px;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;color:#8291a8;font-size:.78rem}
    .footer-bottom strong{color:#c9d8ee}
    .back-top{position:fixed;right:22px;bottom:22px;width:44px;height:44px;border-radius:13px;background:var(--blue);color:#fff;display:grid;place-items:center;box-shadow:0 8px 22px #1769e855;opacity:0;pointer-events:none;transform:translateY(10px);transition:.25s;z-index:50}
    .back-top.show{opacity:1;pointer-events:auto;transform:translateY(0)}
    .reveal{opacity:0;transform:translateY(22px);transition:opacity .65s ease,transform .65s ease}
    .reveal.visible{opacity:1;transform:none}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}.reveal{opacity:1;transform:none}}
    @media(max-width:980px){
      .nav-links{gap:17px}.nav-links a{font-size:.84rem}.hero-grid{gap:25px}.float-one{right:-15px}
      .about-grid{gap:35px}.cards-grid{grid-template-columns:repeat(2,1fr)}.why-grid{grid-template-columns:repeat(2,1fr)}
      .live-grid{gap:30px}.contact-grid{gap:30px}
    }
    @media(max-width:760px){
      .section{padding:76px 0}.site-header{height:72px}.menu-toggle{display:block}
      .nav-cta{display:none}.nav-links{position:absolute;top:71px;left:0;right:0;background:#fff;padding:10px 22px 22px;display:none;flex-direction:column;align-items:stretch;gap:0;border-bottom:1px solid var(--line);box-shadow:0 15px 25px #0a285015}
      .nav-links.open{display:flex}.nav-links a{padding:13px 4px;border-bottom:1px solid #eef2f8;font-size:.95rem}
      .hero{padding:72px 0 65px}.hero-grid,.about-grid,.live-grid,.contact-grid{grid-template-columns:1fr}
      .hero-copy{text-align:center}.hero-copy .eyebrow{justify-content:center}.hero-copy>p{margin-left:auto;margin-right:auto}
      .hero-actions,.hero-proof{justify-content:center}.hero-visual{min-height:420px;margin-top:5px}.phone{transform:rotate(-4deg) scale(.88)}
      .float-one{right:2px;top:40px}.float-two{left:0;bottom:40px}
      .about-art{min-height:310px;order:2}.about-copy{order:1}.feature-mini{grid-template-columns:repeat(3,1fr)}
      .live-grid{gap:20px}.app-preview{min-height:300px;order:2}.live-copy{order:1;text-align:center}.app-points{justify-content:center}
      .why-grid{grid-template-columns:1fr 1fr}.process-grid{grid-template-columns:repeat(2,1fr);row-gap:35px}.process-grid:before{display:none}
      .contact-info{padding:28px}.footer-grid{grid-template-columns:1fr 1fr;gap:35px}.footer-brand{grid-column:1/-1}
    }
    @media(max-width:480px){
      .container{width:min(100% - 30px,1160px)}.brand{font-size:.9rem}.brand-mark{width:38px;height:38px}
      .hero h1{font-size:2.55rem}.hero-copy>p{font-size:.98rem}.hero-actions .btn{width:100%}
      .hero-visual{min-height:370px}.phone{transform:scale(.78) rotate(-4deg)}.float-card{font-size:.7rem;padding:9px 11px}.float-card i{width:30px;height:30px}
      .feature-mini{grid-template-columns:1fr}.mini-item{display:flex;align-items:center;gap:12px;padding:12px}.mini-item i{margin:0}
      .cards-grid,.why-grid{grid-template-columns:1fr}.service-card{padding:24px}
      .process-grid{gap:27px 10px}.process-step{padding:0 3px}.process-step p{font-size:.8rem}.step-icon{width:62px;height:62px}
      .form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}
      .footer-grid{grid-template-columns:1fr;gap:25px}.footer-brand{grid-column:auto}.footer-bottom{flex-direction:column}
      .app-tile{width:175px;height:175px;border-radius:40px}.app-tile i{font-size:4.5rem}.app-orbit{width:260px;height:260px}
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container nav-wrap">
